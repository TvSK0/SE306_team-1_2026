<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- AI-assisted: US8, the Borrowers tab of a loan (mockup 5), included by loan-screen.fxml,
     which has the header and the stylesheet. The table lists everyone else on the loan;
     select a row to change its type or remove it. LoanBorrowersController fills it. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="lavs.ui.LoanBorrowersController"
      spacing="16">
    <padding><Insets top="20" right="0" bottom="0" left="0"/></padding>

    <HBox spacing="16" alignment="TOP_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label styleClass="section" text="Co-borrowers and guarantors"/>
            <Label styleClass="note" wrapText="true"
                   text="Other customers on this loan. If the main borrower has no employer, the loan needs a guarantor before it can be submitted for verification."/>
        </VBox>
        <Button fx:id="_refreshButton" text="Refresh" onAction="#onRefresh"/>
    </HBox>
    <Label fx:id="_messageLabel" styleClass="message" wrapText="true" maxWidth="Infinity"
           minHeight="-Infinity" managed="false" visible="false"/>

    <!-- a loan rarely has more than a few borrowers, so the table stays short and the add
         form sits right under it -->
    <TableView fx:id="_table" styleClass="borrowers" prefHeight="200" minHeight="120">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <placeholder><Label fx:id="_emptyLabel" styleClass="note" text="Co-borrowers and guarantors not loaded."/></placeholder>
        <columns>
            <TableColumn fx:id="_nameColumn" text="Name"/>
            <TableColumn fx:id="_numberColumn" text="Customer number"/>
            <TableColumn fx:id="_typeColumn" text="Type"/>
        </columns>
    </TableView>
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button fx:id="_changeTypeButton" text="Change type" onAction="#onChangeType"/>
        <Button fx:id="_removeButton" text="Remove" onAction="#onRemove"/>
    </HBox>

    <VBox styleClass="card" spacing="12">
        <Label styleClass="section" text="Add a co-borrower or guarantor"/>
        <GridPane hgap="24" vgap="2">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <Label text="Customer number *" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <HBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="0">
                <TextField fx:id="_customerNumber" promptText="Select a customer" HBox.hgrow="ALWAYS"/>
                <Button text="Select customer" onAction="#onSelectCustomer"/>
            </HBox>
            <Label fx:id="_customerNumberError" styleClass="error-text" GridPane.rowIndex="2" GridPane.columnIndex="0"/>

            <Label text="Type *" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <ComboBox fx:id="_type" promptText="Co-borrower or guarantor" maxWidth="Infinity"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label fx:id="_typeError" styleClass="error-text" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="_addButton" text="Add to loan" styleClass="primary" onAction="#onAdd"/>
        </HBox>
    </VBox>
</VBox>
