<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import lavs.ui.ConstantDropdown?>

<!-- Optional component: the Relationships tab of a customer record. The customer record
     includes this file with fx:include; RelationshipsController fills it. It shares the loan
     screen's form styles (loan.css) so the two look the same. The table is on the left and
     the add/edit form on the right; the description field only shows for an "Other" type. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="lavs.ui.RelationshipsController"
      stylesheets="@loan.css" styleClass="loan" spacing="16">
    <padding><Insets top="20" right="0" bottom="0" left="0"/></padding>

    <Label fx:id="_messageLabel" styleClass="message" wrapText="true" maxWidth="Infinity"
           managed="false" visible="false"/>

    <HBox spacing="24" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
        <VBox spacing="12" HBox.hgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label styleClass="section" text="Relationships"/>
                    <Label styleClass="note" text="Other customers this customer is related to."/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="_editButton" text="Edit" onAction="#onEdit"/>
                <Button fx:id="_removeButton" text="Remove" onAction="#onRemove"/>
            </HBox>
            <TableView fx:id="_table" styleClass="schedule" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label fx:id="_emptyLabel" styleClass="note" text="No relationships yet."/></placeholder>
                <columns>
                    <TableColumn fx:id="_typeColumn" text="Relationship"/>
                    <TableColumn fx:id="_customerColumn" text="Customer"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="card" spacing="2" prefWidth="320" minWidth="260" maxWidth="360">
            <Label fx:id="_formTitle" styleClass="section" text="Add a relationship"/>
            <Region minHeight="10"/>

            <Label text="Customer number *" styleClass="field-label"/>
            <TextField fx:id="_otherCustomerNumber" promptText="e.g. 01-0001-0005347"/>
            <Label fx:id="_otherCustomerNumberError" styleClass="error-text"/>

            <Label text="Relationship *" styleClass="field-label"/>
            <ConstantDropdown fx:id="_type" category="CustomerRelationshipType" maxWidth="Infinity"/>
            <Label fx:id="_typeError" styleClass="error-text"/>

            <VBox fx:id="_otherTypeBox" spacing="2" managed="false" visible="false">
                <Label text="Describe the relationship *" styleClass="field-label"/>
                <TextField fx:id="_otherType" promptText="e.g. Business partner"/>
                <Label fx:id="_otherTypeError" styleClass="error-text"/>
            </VBox>

            <HBox spacing="8" alignment="CENTER_RIGHT">
                <padding><Insets top="8" right="0" bottom="0" left="0"/></padding>
                <Button fx:id="_cancelButton" text="Clear" onAction="#onCancel"/>
                <Button fx:id="_saveButton" text="Add relationship" styleClass="primary" defaultButton="true"
                        onAction="#onSave"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
