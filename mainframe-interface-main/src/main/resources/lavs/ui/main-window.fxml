<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- TEMPORARY: swap this for the real first screen once Taran's UI shell exists. -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <!-- TEMPORARY: the buttons and tags below only let A1 be checked by eye; A3.3 replaces this window. -->
    <VBox alignment="CENTER" spacing="16">
        <Label text="LAVS - Loan Application and Verification System" styleClass="lavs-page-title"/>
        <HBox alignment="CENTER" spacing="12">
            <Button text="Primary" styleClass="lavs-button-primary"/>
            <Button text="Secondary" styleClass="lavs-button-secondary"/>
            <Button text="Searching..." styleClass="lavs-button-primary" disable="true"/>
            <Button text="Open record" styleClass="lavs-button-link"/>
            <Button text="Delete" styleClass="lavs-button-danger-link"/>
        </HBox>
        <HBox alignment="CENTER" spacing="12">
            <Label text="Active" styleClass="lavs-tag, lavs-tag-success"/>
            <Label text="Inactive" styleClass="lavs-tag, lavs-tag-neutral"/>
            <Label text="Waiting to upload" styleClass="lavs-tag, lavs-tag-warning"/>
            <Label text="Rejected" styleClass="lavs-tag, lavs-tag-danger"/>
            <Label text="New" styleClass="lavs-tag, lavs-tag-info"/>
        </HBox>
    </VBox>
</StackPane>
