<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- US7: the Repayments tab of a loan (mockup 6), included by loan-screen.fxml. The
     summary cards and the table are filled by LoanRepaymentsController. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="lavs.ui.LoanRepaymentsController"
      spacing="16">
    <padding><Insets top="20" right="0" bottom="0" left="0"/></padding>

    <HBox spacing="16" alignment="TOP_LEFT">
        <VBox spacing="2">
            <Label styleClass="section" text="Loan summary and repayment schedule"/>
            <Label styleClass="note" text="Produced by the mainframe from the loan details and refreshed whenever the loan is edited."/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="_refreshButton" text="Refresh" onAction="#onRefresh"/>
    </HBox>
    <Label fx:id="_messageLabel" styleClass="message,problem" wrapText="true" maxWidth="Infinity"
           managed="false" visible="false"/>

    <HBox spacing="12">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="Total amount paid"/>
            <Label fx:id="_totalAmountPaid" styleClass="stat-value" text="-"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="Total interest"/>
            <Label fx:id="_totalInterestPaid" styleClass="stat-value" text="-"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="Number of payments"/>
            <Label fx:id="_numberOfPayments" styleClass="stat-value" text="-"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="Final payment date"/>
            <Label fx:id="_finalPaymentDate" styleClass="stat-value" text="-"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="Final payment"/>
            <Label fx:id="_finalPaymentAmount" styleClass="stat-value" text="-"/>
        </VBox>
    </HBox>

    <TableView fx:id="_scheduleTable" styleClass="schedule" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <placeholder><Label fx:id="_emptyLabel" styleClass="note" text="No repayments loaded yet."/></placeholder>
        <columns>
            <TableColumn fx:id="_numberColumn" text="No." sortable="false" maxWidth="70" minWidth="50"/>
            <TableColumn fx:id="_dateColumn" text="Payment date" sortable="false"/>
            <TableColumn fx:id="_paymentColumn" text="Payment" sortable="false"/>
            <TableColumn fx:id="_principalColumn" text="Principal" sortable="false"/>
            <TableColumn fx:id="_interestColumn" text="Interest" sortable="false"/>
            <TableColumn fx:id="_remainingColumn" text="Remaining balance" sortable="false"/>
        </columns>
    </TableView>
</VBox>
